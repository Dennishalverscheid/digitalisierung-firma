    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Welche Materialien verwendet ihr für eure Produkte?",
            "text": "<p>Wir setzen auf hochwertiges Echtleder, Alcantara und Carbon, um langlebige und exklusive Veredelungen zu garantieren.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "<strong> Kann ich mein Fahrzeug individuell anpassen lassen?</strong>",
            "text": "<p>Ja! Wir bieten maßgeschneiderte Lösungen für Lenkräder, Sitze, Schaltwippen und mehr. Kontaktiere uns für ein persönliches Angebot.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "Wie lange dauert die Anfertigung?",
            "text": "<p>Je nach Produkt und Individualisierung dauert die Fertigung in der Regel zwischen 7 und 14 Werktagen.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "title": "Bietet ihr internationalen Versand an?",
            "text": "<p>Ja, wir versenden weltweit! Die Versanddauer und -kosten hängen vom jeweiligen Zielort ab.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "title": "Wie pflege ich meine neuen Leder- oder Alcantara-Produkte?",
            "text": "<p>Wir empfehlen spezielle Pflegeprodukte für Leder und Alcantara. Eine genaue Anleitung findest du auf unserer Pflege-Seite.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Hast du noch Fragen?",
            "text": "<p>Schreib uns einfach & wir melden uns so schnell wie möglich.</p>",
            "show_phone": false,
            "avatar_height": 60,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "question-1",
