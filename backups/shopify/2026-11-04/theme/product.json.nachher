"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"image-with-text-2":{"type":"image-with-text","blocks":{"image":{"type":"image","settings":{"image_width":"custom","image_max_width":50,"image_max_width_mobile":50}},"heading":{"type":"heading","settings":{"heading":"<strong>Handwerkskunst auf höchstem Niveau</strong>","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text":{"type":"text","settings":{"text":"<p>Jedes Detail zählt – feinste Materialien und präzise Verarbeitung machen den Unterschied. Qualität, die du sehen und fühlen kannst.</p>","text_font":"body","text_size":"subtext-md","text_max_size":32,"text_line_height":1.6,"text_letter_spacing":0,"text_capitalize":false,"secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["image","heading","text"],"settings":{"image":"shopify://shop_images/image00215-rot_023dfefb-597f-418c-8a35-612915251ab3.jpg","image_height":"600px","image_width":"medium","layout":"text_first","text_alignment":"left","content_position":"align-self-center","image_height_mobile":"400px","text_alignment_mobile":"left","color_text":"#171717","color_background":"","gradient_background":"","color_background_2":"#fafafa","gradient_background_2":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":false,"parallax_direction":"vertical"}},"product-details":{"type":"product-details","blocks":{"collapsible_tab-1":{"type":"collapsible_tab","settings":{"icon":"none","iwidth":"custom","icon_width":24,"heading":"Collapsible row 1","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>","metafields":"","text_size":"text-base"}},"collapsible_tab-2":{"type":"collapsible_tab","settings":{"icon":"none","iwidth":"custom","icon_width":24,"heading":"Collapsible row 2","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>","metafields":"","text_size":"text-base"}},"collapsible_tab-3":{"type":"collapsible_tab","settings":{"icon":"none","iwidth":"custom","icon_width":24,"heading":"Collapsible row 3","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>","metafields":"","text_size":"text-base"}},"collapsible_tab-4":{"type":"collapsible_tab","settings":{"icon":"none","iwidth":"custom","icon_width":24,"heading":"Collapsible row 4","content":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>","metafields":"","text_size":"text-base"}}},"block_order":["collapsible_tab-1","collapsible_tab-2","collapsible_tab-3","collapsible_tab-4"],"disabled":true,"settings":{"style":"with-border","open_first_row":true,"specifications_heading":"","heading":"Product details","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"#000000","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":28,"padding_bottom":28,"divider":false,"full_width":false,"rounded":false}},"faq":{"type":"faq","blocks":{"question-1":{"type":"question","settings":{"title":"Welche Materialien verwendet ihr für eure Produkte?","text":"<p>Wir setzen auf hochwertiges Echtleder, Alcantara und Carbon, um langlebige und exklusive Veredelungen zu garantieren.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-2":{"type":"question","settings":{"title":"<strong> Kann ich mein Fahrzeug individuell anpassen lassen?</strong>","text":"<p>Ja! Wir bieten maßgeschneiderte Lösungen für Lenkräder, Sitze, Schaltwippen und mehr. Kontaktiere uns für ein persönliches Angebot.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-3":{"type":"question","settings":{"title":"Wie lange dauert die Anfertigung?","text":"<p>Die Fertigungs- und Lieferzeit ist auf der jeweiligen Produktseite direkt über dem Warenkorb-Button angegeben.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-4":{"type":"question","settings":{"title":"Bietet ihr internationalen Versand an?","text":"<p>Ja. Wir liefern innerhalb der EU sowie in ausgewählte weitere Länder. Alle Liefergebiete und Versandkosten findest du unter <a href=\"/policies/shipping-policy\">Versand &amp; Zahlung</a>.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question-5":{"type":"question","settings":{"title":"Wie pflege ich meine neuen Leder- oder Alcantara-Produkte?","text":"<p>Wir empfehlen spezielle Pflegeprodukte für Leder und Alcantara, zum Beispiel unser <a href=\"/products/pss-alcantara-reiniger-set\">PSS Alcantara Reinigungsset</a>.</p>","highlighted_text":"none","highlighted_scribble":"circle"}},"contact":{"type":"contact","settings":{"heading":"Hast du noch Fragen?","text":"<p>Schreib uns einfach & wir melden uns so schnell wie möglich.</p>","show_phone":false,"avatar_height":60,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question-1","question-2","question-3","question-4","question-5","contact"],"settings":{"style":"with-background","heading":"Fragen & Antworten","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"<p>Bitte lesen Sie mehr auf unsere FAQ-Seite.</p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"#ffffff","color_background":"#171717","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"#171717","color_button_background":"#ffffff","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":84,"padding_bottom":84,"divider":false,"narrow":false,"rounded":false}},"product-recommendations":{"type":"product-recommendations","settings":{"product_limit":6,"columns":4,"carousel_on_desktop":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Das könnte dir auch gefallen","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":true}},"recently-viewed":{"type":"recently-viewed","disabled":true,"settings":{"product_limit":6,"columns":4,"carousel_on_desktop":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Recently Viewed","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}}},"order":["main-product","help-drawer","rich_text_kfdNrh","image-with-text-1","image-with-text-2","product-details","f