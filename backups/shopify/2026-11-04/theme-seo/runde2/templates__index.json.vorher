    "testimonials-banner": {
      "type": "testimonials-banner",
      "blocks": {
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>Absolut top! Ich bin wirklich begeistert in der heutigen Zeit, noch eine Sattlerei gefunden zu haben in der Kundenzufriedenheit an erster Stelle steht.</p>",
            "author": "Tom S.",
            "author_info": "",
            "author_url": "",
            "image_ratio": "rounded",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "testimonial-2": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>Die Kommunikation war jederzeit freundlich und zuverlässig, die Durchführung absolut professionell und die Abholung verlief reibungslos. Rundum ein Top-Service - sehr empfehlenswert! </p>",
            "author": "Daniel N.",
            "author_info": "",
            "author_url": "",
            "image_ratio": "rounded",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "testimonial-3": {
          "type": "testimonial",
          "settings": {
            "icon": "quote",
            "text": "<p>Das Ergebnis hat meine Erwartungen um ein vielfaches übertroffen. Das Carbon, die roten Nähte und wie es in der Hand liegt, absolute Spitzenarbeit. Vielen Dank an Dennis und das tolle Team. </p>",
            "author": "Carsten B.",
            "author_info": "",
            "author_url": "",
            "image_ratio": "rounded",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
      "block_order": [
        "testimonial-1",
        "testimonial-2",
        "testimonial-3"
      ],
